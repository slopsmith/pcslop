#!/usr/bin/env bash
# Builds target/pcslop.app: the SwiftUI machine manager plus the pcslop binary,
# the libraries it links from /nix/store, and SeaBIOS, ad hoc signed.
# Usage: apps/macos/Tools/bundle-app
set -euo pipefail

pkg=$(cd "$(dirname "$0")/.." && pwd)
root=$(cd "$pkg/../.." && pwd)
cd "$root"
app=target/pcslop.app
contents=$app/Contents
swift() { env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift "$@"; }

bios=references/seabios/share/seabios/bios.bin
vgabios=references/seavgabios/share/seabios/vgabios.bin
for f in "$bios" "$vgabios"; do
	[ -e "$f" ] || { echo "error: $f is missing; see README.md for nix build .#seabios" >&2; exit 1; }
done

echo "== building pcslop (release)"
nix develop . -c env CARGO_TARGET_DIR="$root/target/work" cargo build --release -p pcslop

echo "== building the manager"
swift build -c release --package-path "$pkg"
manager=$(swift build -c release --package-path "$pkg" --show-bin-path)/pcslop-manager

echo "== assembling $app"
rm -rf "$app"
mkdir -p "$contents/MacOS" "$contents/Frameworks" "$contents/Resources"
cp "$manager" "$contents/MacOS/pcslop-manager"
cp -R "$(dirname "$manager")/pcslop-manager_Manager.bundle" "$contents/Resources/"
cp target/work/release/pcslop "$contents/MacOS/pcslop"
cp "$bios" "$contents/Resources/bios.bin"
cp "$vgabios" "$contents/Resources/vgabios.bin"
chmod u+w "$contents/MacOS/"* "$contents/Resources/"*

iconset=$(mktemp -d)/AppIcon.iconset
swift "$pkg/Tools/make-icon.swift" "$iconset"
/usr/bin/iconutil -c icns -o "$contents/Resources/AppIcon.icns" "$iconset"
rm -rf "$(dirname "$iconset")"

version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/pcslop/Cargo.toml | head -n1)
cat >"$contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>pcslop-manager</string>
	<key>CFBundleIdentifier</key><string>dev.pcslop.manager</string>
	<key>CFBundleName</key><string>pcslop</string>
	<key>CFBundleDisplayName</key><string>pcslop</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>${version:-0.1.0}</string>
	<key>CFBundleVersion</key><string>${version:-0.1.0}</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

# Copies every /nix/store library pcslop needs (and what those need) into
# Frameworks, and points all references at @rpath. Two different libraries can
# share a file name, so the second gets its store hash.
nix_deps() { otool -L "$1" | awk 'NR > 1 && $1 ~ /^\/nix\/store\// { print $1 }'; }
copied=$(mktemp)
trap 'rm -f "$copied"' EXIT

queue=("$contents/MacOS/pcslop")
while ((${#queue[@]})); do
	file=${queue[0]}
	queue=("${queue[@]:1}")
	for dep in $(nix_deps "$file"); do
		name=$(awk -v d="$dep" '$1 == d { print $2 }' "$copied")
		if [ -z "$name" ]; then
			name=$(basename "$dep")
			if [ -e "$contents/Frameworks/$name" ]; then
				hash=$(echo "$dep" | cut -d/ -f4 | cut -c1-8)
				name="$hash-$name"
			fi
			dest="$contents/Frameworks/$name"
			cp "$dep" "$dest"
			chmod u+w "$dest"
			install_name_tool -id "@rpath/$name" "$dest" 2>/dev/null
			echo "$dep $name" >>"$copied"
			queue+=("$dest")
		fi
		install_name_tool -change "$dep" "@rpath/$name" "$file" 2>/dev/null
	done
done

for lib in "$contents/Frameworks/"*.dylib; do
	[ -e "$lib" ] || continue
	for rp in $(otool -l "$lib" | awk '/LC_RPATH/ { getline; getline; print $2 }'); do
		install_name_tool -delete_rpath "$rp" "$lib" 2>/dev/null
	done
	install_name_tool -add_rpath "@loader_path" "$lib" 2>/dev/null
done
for rp in $(otool -l "$contents/MacOS/pcslop" | awk '/LC_RPATH/ { getline; getline; print $2 }'); do
	case $rp in /nix/store/*) install_name_tool -delete_rpath "$rp" "$contents/MacOS/pcslop" 2>/dev/null ;; esac
done
install_name_tool -add_rpath "@executable_path/../Frameworks" "$contents/MacOS/pcslop" 2>/dev/null

leftover=$(for f in "$contents/MacOS/"* "$contents/Frameworks/"*; do [ -e "$f" ] && otool -L "$f" | grep /nix/store || true; done)
if [ -n "$leftover" ]; then
	echo "error: the bundle still links into /nix/store:" >&2
	echo "$leftover" >&2
	exit 1
fi

echo "== signing (ad hoc)"
for lib in "$contents/Frameworks/"*.dylib; do
	[ -e "$lib" ] && codesign -s - -f "$lib" 2>/dev/null
done
codesign -s - -f --entitlements scripts/hypervisor.entitlements "$contents/MacOS/pcslop"
codesign -s - -f "$contents/MacOS/pcslop-manager"
codesign -s - -f "$app"
codesign --verify --strict --deep "$app"

echo "== done: $app"
