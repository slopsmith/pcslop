#!/usr/bin/env bash
# Builds target/pcslop.app: the SwiftUI machine manager plus the pcslop binary,
# the libraries it links from /nix/store, and SeaBIOS, ad hoc signed, then runs
# the upload checks. The shared steps are slop-app from slopsmith/ci.
# Usage: apps/macos/Tools/bundle-app
set -euo pipefail

pkg=$(cd "$(dirname "$0")/.." && pwd)
root=$(cd "$pkg/../.." && pwd)
cd "$root"
app=target/pcslop.app
contents=$app/Contents
swift() { env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift "$@"; }

bios=references/seabios/share/seabios/bios.bin
vgabios=references/seavgabios/share/seabios/vgabios.bin
for f in "$bios" "$vgabios"; do
	[ -e "$f" ] || { echo "error: $f is missing; see README.md for nix build .#seabios" >&2; exit 1; }
done

slop=$(nix build --no-link --print-out-paths .#slop-app)/bin/slop-app
commit=$("$slop" commit)
version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)

echo "== building pcslop (release) at $commit"
nix develop . -c env CARGO_TARGET_DIR="$root/target/work" SLOP_COMMIT="$commit" cargo build --release -p pcslop

echo "== building the manager"
swift build -c release --package-path "$pkg"
manager=$(swift build -c release --package-path "$pkg" --show-bin-path)/pcslop-manager

echo "== assembling $app"
rm -rf "$app"
mkdir -p "$contents/MacOS" "$contents/Resources"
cp "$manager" "$contents/MacOS/pcslop-manager"
cp -R "$(dirname "$manager")/pcslop-manager_Manager.bundle" "$contents/Resources/"
cp target/work/release/pcslop "$contents/MacOS/pcslop"
cp "$bios" "$contents/Resources/bios.bin"
cp "$vgabios" "$contents/Resources/vgabios.bin"
chmod u+w "$contents/MacOS/"* "$contents/Resources/"*

iconset=$(mktemp -d)/AppIcon.iconset
swift "$pkg/Tools/make-icon.swift" "$iconset"
/usr/bin/iconutil -c icns -o "$contents/Resources/AppIcon.icns" "$iconset"
rm -rf "$(dirname "$iconset")"

"$slop" plist "$app" executable=pcslop-manager id=dev.pcslop.manager name=pcslop \
	category=developer-tools version="$version" commit="$commit"
"$slop" nix-libs "$app" Contents/MacOS/pcslop
nix develop . -c "$slop" licenses "$app" "$pkg/Licenses" crates/pcslop/Cargo.toml
cp LICENSE "$contents/Resources/Licenses/pcslop (GPL-2.0).txt"

echo "== signing (ad hoc)"
"$slop" sign "$app" scripts/hypervisor.entitlements Contents/MacOS/pcslop

echo "== checking"
"$slop" check "$app" Contents/MacOS/pcslop
echo "== done: $app"
