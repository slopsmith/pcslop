#!/usr/bin/env bash
# Saves preview screenshots of the manager with a few sample machines into DIR
# (default: target/manager-screenshots). It opens the app's window, so the
# screen must be unlocked, or the captures fall back to drawing without Liquid Glass.
# Usage: apps/macos/Tools/screenshots [DIR]
set -euo pipefail

pkg=$(cd "$(dirname "$0")/.." && pwd)
dir=${1:-$pkg/../../target/manager-screenshots}
mkdir -p "$dir"
out=$(cd "$dir" && pwd)
swift() { env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift "$@"; }

swift build --package-path "$pkg"
bin=$(swift build --package-path "$pkg" --show-bin-path)/pcslop-manager

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
machine() {
	mkdir -p "$tmp/store/$1" "$tmp/empty"
	cat >"$tmp/store/$1/machine.json" <<JSON
{"id": "$1", "name": "$2", "os": "$3", "created": "2026-01-01T00:00:00Z", "config": $4}
JSON
}
machine 11111111-1111-1111-1111-111111111111 "Windows XP" windows-xp \
	'{"board": "bx", "gpu": "radeon", "vgaROM": "/roms/r300.rom", "ramMiB": 512, "hda": "/disks/xp.img", "captureMouse": "auto"}'
machine 22222222-2222-2222-2222-222222222222 "Ubuntu 8.04" ubuntu \
	'{"ramMiB": 1024, "cdrom": "/isos/ubuntu-8.04-desktop-i386.iso", "hostForwards": ["tcp::2222-:22"]}'
machine 33333333-3333-3333-3333-333333333333 "FreeDOS" dos '{"ramMiB": 64, "audio": false, "network": false, "extraArgs": "--headless"}'

app=$tmp/Manager.app
mkdir -p "$app/Contents/MacOS"
cp "$bin" "$app/Contents/MacOS/pcslop-manager"
mkdir -p "$app/Contents/Resources"
cp -R "$(dirname "$bin")/pcslop-manager_Manager.bundle" "$app/Contents/Resources/"
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>CFBundleExecutable</key><string>pcslop-manager</string>
	<key>CFBundleIdentifier</key><string>dev.pcslop.manager.screenshots</string>
	<key>CFBundlePackageType</key><string>APPL</string>
</dict></plist>
PLIST
codesign -s - -f "$app" 2>/dev/null

shot() {
	local name=$1
	shift
	echo "== $name"
	open -g -n -W "$app" --args --window 1280x800 --snapshot "$out/$name.png" "$@"
}
shot welcome-empty --store "$tmp/empty" --appearance dark
shot welcome --store "$tmp/store" --appearance dark
shot machine-dark --store "$tmp/store" --appearance dark --select "Windows XP"
shot machine-light --store "$tmp/store" --appearance light --select "Windows XP"
shot settings --store "$tmp/store" --appearance dark --select "Windows XP" --open settings
shot settings-light --store "$tmp/store" --appearance light --select "Ubuntu 8.04" --open settings
shot new-machine --store "$tmp/store" --appearance dark --open new
shot new-machine-drives --store "$tmp/store" --appearance dark --open new-drives
shot settings-system --store "$tmp/store" --appearance dark --select "Windows XP" --open settings --page system
shot preferences --store "$tmp/store" --appearance dark --open preferences
shot display-no-rom --store "$tmp/store" --appearance dark --select "Windows XP" --open settings --page display
shot network --store "$tmp/store" --appearance dark --select "Ubuntu 8.04" --open settings --page network
root=$(cd "$pkg/../.." && pwd)
refs=$("$root/scripts/main-checkout")/references
if [ -x "$root/target/vm/pcslop" ]; then
	shot running --store "$tmp/store" --appearance dark --select FreeDOS --open start --delay 13 \
		-pcslopBinary "$root/target/vm/pcslop" -biosPath "$refs/seabios/share/seabios/bios.bin" \
		-vgaBIOSPath "$refs/seavgabios/share/seabios/vgabios.bin"
fi
shot settings-drives --store "$tmp/store" --appearance light --select "Windows XP" --open settings --page drives
echo "screenshots in $out"
