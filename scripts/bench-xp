#!/usr/bin/env bash
# Boots a clone of ~/xp-nomp.img with the XP benchmark CD (bench/xp, built
# by scripts/build-bench into target/bench/xpbench.iso when missing or out of
# date), reports the time to an idle desktop, runs D:\run.bat and prints the
# results it sends to COM1. See bench/README.md.
# Usage: scripts/bench-xp [DISK]; VM_BIN picks the emulator binary.
# BENCH_ISO picks another CD.
# BENCH_TEST=NAME [BENCH_REPEAT=N] runs one test N times through D:\one.bat
# (int sort memcpy fp syscall file pagefault ctxsw process xform blit path
# entity raster physics games 7zip coremark scimark whetstone linpack).
# BENCH_PROFILE=DIR profiles the tests: DIR gets profile.txt, status.txt
# and the hottest blocks for scripts/jit-blocks.
# BENCH_LOG=FILE keeps everything the guest wrote to COM1.
# BENCH_FLAGS adds emulator flags, e.g. --no-jit; BENCH_WAIT (default 600)
# is how many seconds to wait for the tests.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
disk=${1:-$HOME/xp-nomp.img}
iso=${BENCH_ISO:-$root/target/bench/xpbench.iso}
if [ -z "${BENCH_ISO:-}" ]; then
	if [ ! -e "$iso" ] || [ -n "$(find "$root/bench/xp" "$root/nix/xpbench.nix" "$root/scripts/build-bench" -newer "$iso" 2>/dev/null)" ]; then
		"$root/scripts/build-bench" >&2
	fi
fi
batch='D:\run.bat'
[ -n "${BENCH_TEST:-}" ] && batch="D:\one.bat $BENCH_TEST ${BENCH_REPEAT:-1}"
tmp=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || echo "${TMPDIR:-/tmp}")
tmp=${tmp%/}
name=xpb$$
img=$tmp/$name.img
serial=$tmp/$name.serial
cp -c "$disk" "$img"
: >"$serial"
cleanup() {
	"$root/scripts/vm" stop "$name" >/dev/null 2>&1 || true
	if [ -n "${BENCH_LOG:-}" ]; then cp "$serial" "$BENCH_LOG"; fi
	rm -f "$img" "$serial"
}
trap cleanup EXIT
vm() { "$root/scripts/vm" "$@"; }
mips() { vm status "$name" | sed -n 's/.*mips \([0-9.]*\).*/\1/p' | cut -d. -f1; }
start=$(date +%s)
[ -n "${BENCH_PROFILE:-}" ] && export SLOPPER_JIT_PROFILE=1
# shellcheck disable=SC2086
VM_TIMEOUT=${VM_TIMEOUT:-900} vm start "$name" --hda "$img" --cdrom "$iso" --ram 256 --no-net --serial "$serial" ${BENCH_FLAGS:-} >/dev/null
busy=0 low=0
for _ in $(seq 300); do
	sleep 1
	m=$(mips || echo 0)
	[ "${m:-0}" -gt 20 ] && busy=1
	if [ $busy = 1 ] && [ "${m:-0}" -lt 3 ]; then low=$((low + 1)); else low=0; fi
	[ $low -ge 4 ] && break
done
echo "idle desktop after $(($(date +%s) - start - 4)) s"
if [ -n "${BENCH_PROFILE:-}" ]; then
	mkdir -p "$BENCH_PROFILE"
	vm ctl "$name" "profile on" >/dev/null
fi
vm ctl "$name" "key lwin+r" >/dev/null
sleep 2
vm ctl "$name" "type $batch" >/dev/null
sleep 2
vm ctl "$name" "key enter" >/dev/null
done=0
for _ in $(seq "${BENCH_WAIT:-600}"); do
	grep -aq "BENCH-DONE" "$serial" && done=1 && break
	sleep 1
done
if [ -n "${BENCH_PROFILE:-}" ]; then
	vm ctl "$name" profile >"$BENCH_PROFILE/profile.txt"
	vm ctl "$name" status >"$BENCH_PROFILE/status.txt"
	vm ctl "$name" "profile blocks $BENCH_PROFILE 60" >/dev/null
fi
[ $done = 1 ] || echo "no BENCH-DONE after ${BENCH_WAIT:-600} s" >&2
tr -d '\r' <"$serial" | awk -f "$root/bench/xp/summary.awk"
