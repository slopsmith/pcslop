#!/usr/bin/env python3
"""Sends commands to a running emulator's control socket and prints the answers.

Usage: scripts/ctl SOCKET COMMAND [COMMAND...]   (each COMMAND is one line, quote it)
"""
import socket
import sys

if len(sys.argv) < 3:
    sys.exit(__doc__)
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(sys.argv[1])
f = sock.makefile("rw")
for cmd in sys.argv[2:]:
    f.write(cmd + "\n")
    f.flush()
    for line in f:
        if line.rstrip("\n") == ".":
            break
        sys.stdout.write(line)
